<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="26">
  <CheatEntries>
	<CheatEntry>
	  <ID>1</ID>
	  <Description>"Activate Trainer (After Activate Trainers, Be Sure to View Main Menu Where You See Your Money)"</Description>
	  <Options moHideChildren="1"/>
	  <VariableType>Auto Assembler Script</VariableType>
	  <AssemblerScript>[ENABLE]
{$lua}

lua_aobscan_last_2("GetBasePointersAOB",process,"0F 88 * * * * E9 * * * * 8B 0D * * * * 81 C1 98 00 00 00 48 8B 5C 0D 00 48 8B 35 * * * * 89 F1",0x100000000)

local CurrentSaveSymbolList = {
"InfiniteItem",
"InfiniteGP",
"InfiniteHP",
"InfinitePartySP",
"InfiniteRuneUse",
"InfiniteRuneUseBattle",
"QuickLevelGain",
"SetSPAllParty",
"SetAllSkillsToSS",
"SetAllPDFToMax",
"SetAllMDFToMax",
"GPMultiplier"
}

-- First, make sure Save Symbol List global variable is empty
for i=#SaveSymbolList,1,-1 do
	table.remove(SaveSymbolList,i)
end

for j=1,#CurrentSaveSymbolList do
	-- Insert our custom symbol list for this trainer into the global variable
	table.insert(SaveSymbolList,CurrentSaveSymbolList[j])
end

{$asm}

alloc(newmem,2048)

///
alloc(newmem2,1024,GetBasePointersAOB)

///
label(return2)

///
label(FirstPartyCurrentHPOffset)
registersymbol(FirstPartyCurrentHPOffset)
label(PotchOffsetOffset)
registersymbol(PotchOffsetOffset)
label(FirstPartyItemOneQtyOffset)
registersymbol(FirstPartyItemOneQtyOffset)
label(FirstPartyExpOffset)
registersymbol(FirstPartyExpOffset)
label(iPartySlot)
registersymbol(iPartySlot)
label(FirstPartyEXPPtr)
registersymbol(FirstPartyEXPPtr)
label(FirstPartyItemOneQtyPtr)
registersymbol(FirstPartyItemOneQtyPtr)
label(FirstPartyEXPPtrOffset)
registersymbol(FirstPartyEXPPtrOffset)
label(FirstPartyItemOneQtyPtrOffset)
registersymbol(FirstPartyItemOneQtyPtrOffset)

label(CharacterInfoOffset)
registersymbol(CharacterInfoOffset)
label(CharacterInfoNumPartyMembers)
registersymbol(CharacterInfoNumPartyMembers)
label(InfiniteRuneUse)
registersymbol(InfiniteRuneUse)
label(SetAllPDFToMax)
