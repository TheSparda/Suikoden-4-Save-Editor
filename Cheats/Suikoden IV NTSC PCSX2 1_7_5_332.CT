///
GPMultiplier:
dq #10
InfiniteGP:
dq 0
GPInitialized:
dq 0
SavedGP:
dq 0

///
OurBasePtr:
dq 0
bInitializedPointers:
dq 0

newmem2:
  mov [R15Save2],r15
  cmp rcx,535EF8
  jne MyCleanUp2
  mov r15,OurBasePtr
  mov [r15],rbp
  jmp MyCleanUp2
  
MyCleanUp2:
  mov r15,[R15Save2]
  jmp originalcode2
  
originalcode2:
  mov rbx,[rbp+rcx+00]
  jmp return2

R15Save2:
dq 0

GetBasePointersAOB+17:
  jmp newmem2
  return2:
  
