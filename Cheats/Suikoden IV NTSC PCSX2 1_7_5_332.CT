///
label(OurBasePtr)
registersymbol(OurBasePtr)
label(bInitializedPointers)
registersymbol(bInitializedPointers)

///
newmem:
FirstPartyExpOffset:
dq 532968
FirstPartyItemOneQtyOffset:
dq 532920
PotchOffsetOffset:
dq 535EF8
FirstPartyCurrentHPOffset:
dq 1B8D60

///
iPartySlot:
dq 0
FirstPartyEXPPtr:
dq 0
FirstPartyItemOneQtyPtr:
dq 0
FirstPartyEXPPtrOffset:
dq 532968
FirstPartyItemOneQtyPtrOffset:
dq 532920

///
CharacterInfoOffset:
dq 78
CharacterInfoNumPartyMembers:
dq #113
SetSPAllParty:
dq 0
InfiniteRuneUse:
dq 1
SetAllPDFToMax:
dq 0
SetAllMDFToMax:
dq 0
RushAlwaysAvailable:
dq 1
InfiniteItemUse:
dq 0
NoRandomBattles:
dq 0
QuickLevelGain:
dq 0
WorldMapFullyExplored:
dq 0

///
BattleInfoOffset:
dq DC
BattleInfoNumPartyMembers:
dq 4
InfiniteHP:
dq 0
InfiniteRuneUseBattle:
