</AssemblerScript>
	  <Hotkeys>
		<Hotkey>
		  <Action>Activate</Action>
		  <Keys>
			<Key>112</Key>
		  </Keys>
		  <ID>0</ID>
		</Hotkey>
	  </Hotkeys>
	</CheatEntry>
	<CheatEntry>
	  <ID>2</ID>
	  <Description>"Activate Trainer 2"</Description>
	  <Options moHideChildren="1"/>
	  <VariableType>Auto Assembler Script</VariableType>
	  <AssemblerScript>[ENABLE]
{$lua}

WriteInteger(getAddressSafe("bInitializedPointers"),0)

tMainPointerTimer = createTimer(nil, false)
tMainPointerTimer.OnTimer = function(fMainPointerTimer)

	local OurBasePtr = ReadPointer(getAddressSafe("OurBasePtr"))
	local bInitializedPointers = ReadInteger(getAddressSafe("bInitializedPointers"))

	if (OurBasePtr ~= nil) then
		if (OurBasePtr ~= 0) then		
			local FirstPartyExpOffset = ReadPointer(getAddressSafe("FirstPartyExpOffset"))
			local FirstPartyExp = FirstPartyExpOffset + OurBasePtr
			registerSymbol("FirstPartyExp",FirstPartyExp)
			
			local FirstPartyItemOneQtyOffset = ReadPointer(getAddressSafe("FirstPartyItemOneQtyOffset"))
			local FirstPartyItemOneQty = FirstPartyItemOneQtyOffset + OurBasePtr
			registerSymbol("FirstPartyItemOneQty",FirstPartyItemOneQty)
			
			local PotchOffsetOffset = ReadPointer(getAddressSafe("PotchOffsetOffset"))
			local PotchOffset = PotchOffsetOffset + OurBasePtr
			registerSymbol("PotchOffset",PotchOffset)

			local FirstPartyCurrentHPOffset = ReadPointer(getAddressSafe("FirstPartyCurrentHPOffset"))
			local FirstPartyCurrentHP = FirstPartyCurrentHPOffset + OurBasePtr
			registerSymbol("FirstPartyCurrentHP",FirstPartyCurrentHP)
			
			local FirstPartyEXPPtrOffset = ReadPointer(getAddressSafe("FirstPartyEXPPtrOffset"))
			local FirstPartyEXPPtr = FirstPartyEXPPtrOffset + OurBasePtr
			WritePointer(getAddressSafe("FirstPartyEXPPtr"),FirstPartyEXPPtr)

			local FirstPartyItemOneQtyPtrOffset = ReadPointer(getAddressSafe("FirstPartyItemOneQtyPtrOffset"))
			local FirstPartyItemOneQtyPtr = FirstPartyItemOneQtyPtrOffset + OurBasePtr
			WritePointer(getAddressSafe("FirstPartyItemOneQtyPtr"),FirstPartyItemOneQtyPtr)

			WriteInteger(getAddressSafe("bInitializedPointers"),1)
		end
	end
	
	if (bInitializedPointers == 1) then
		tMainPointerTimer.destroy()
	end
end

tMainPointerTimer.Interval = 100
tMainPointerTimer.Enabled = true

{$asm}

[DISABLE]
{$lua}

tMainPointerTimer.destroy()

{$asm}

unregistersymbol(FirstPartyEXP)
unregistersymbol(FirstPartyItemOneQty)
unregistersymbol(PotchOffset)
unregistersymbol(FirstPartyCurrentHP)

</AssemblerScript>
	  <Hotkeys>
		<Hotkey>
		  <Action>Activate</Action>
		  <Keys>
			<Key>112</Key>
		  </Keys>
		  <ID>0</ID>
		</Hotkey>
	  </Hotkeys>
	</CheatEntry>
	<CheatEntry>
	  <ID>3</ID>
	  <Description>"Activate Trainer 3"</Description>
	  <Options moHideChildren="1"/>
	  <VariableType>Auto Assembler Script</VariableType>
	  <AssemblerScript>[ENABLE]
{$lua}

tMainTimer = createTimer(nil, false)
tMainTimer.OnTimer = function(fMainTimer)

	local OurProcess = getAddressSafe(process)
	local ourindex = 0
	local FirstPartyItemOneQty = getAddressSafe("FirstPartyItemOneQty")
	local FirstPartyExp = getAddressSafe("FirstPartyExp")
	local CharacterInfoOffset = ReadInteger(getAddressSafe("CharacterInfoOffset"))
	local CharacterInfoNumPartyMembers = ReadInteger(getAddressSafe("CharacterInfoNumPartyMembers"))
	local BattleInfoOffset = ReadInteger(getAddressSafe("BattleInfoOffset"))
	local FirstPartyCurrentHP = getAddressSafe("FirstPartyCurrentHP")
	local BattleInfoNumPartyMembers = ReadInteger(getAddressSafe("BattleInfoNumPartyMembers"))
	local OurBasePtr = getAddressSafe("OurBasePtr")
	
	if (OurBasePtr ~= nil) then
		if (OurBasePtr ~= 0) then
			local OurBasePtr1 = ReadPointer(OurBasePtr)
			
			if (OurBasePtr1 ~= nil) then
				if (OurBasePtr1 ~= 0) then	
					if (FirstPartyItemOneQty ~= nil) then
						if (FirstPartyItemOneQty ~= 0) then
							-- First, Do World Map Fully Explored
							local WorldMapFullyExplored = ReadInteger(getAddressSafe("WorldMapFullyExplored"))
							
							if (WorldMapFullyExplored == 1) then
								local ourindex99 = 0
								local WorldMapAddr = OurBasePtr1 + 0x53D1B0
								
								while (ourindex99 &lt; 0x175) do
									if (ReadInteger(WorldMapAddr + (ourindex99 * 0x04)) ~= (-1)) then
										WriteInteger(WorldMapAddr + (ourindex99 * 0x04),0xFFFFFFFF)
									end
								end
							end
							
							-- First, Do Character Options
							while (ourindex &lt; CharacterInfoNumPartyMembers) do
								local QuickLevelGain = ReadInteger(getAddressSafe("QuickLevelGain"))
								
								if (QuickLevelGain == 1) then
									if (ReadSmallInteger(FirstPartyExp) ~= 999) then
										WriteSmallInteger(FirstPartyExp,999)
									end
								end
								
								local InfiniteRuneUse = ReadInteger(getAddressSafe("InfiniteRuneUse"))
								
								if (InfiniteRuneUse == 1) then
									local MaxRuneUse = ReadInteger(FirstPartyExp + 0x4D)
									if (ReadInteger(FirstPartyExp + 0x49) ~= MaxRuneUse) then
										WriteInteger(FirstPartyExp + 0x49,MaxRuneUse)
									end
								end
												
								local SetAllPDFToMax = ReadInteger(getAddressSafe("SetAllPDFToMax"))
								
								if (SetAllPDFToMax == 1) then
									if (ReadSmallInteger(FirstPartyExp + 0xE) ~= 999) then
										WriteSmallInteger(FirstPartyExp + 0x28,999)
									end
								end
								
								local SetAllMDFToMax = ReadInteger(getAddressSafe("SetAllMDFToMax"))
								
								if (SetAllMDFToMax == 1) then
									if (ReadSmallInteger(FirstPartyExp + 0x10) ~= 999) then
										WriteSmallInteger(FirstPartyExp + 0x2A,999)
									end
								end

								local RushAlwaysAvailable = ReadInteger(getAddressSafe("RushAlwaysAvailable"))
								local RushAvailableAddr = OurBasePtr1 + 0x535F04
								
								if (RushAlwaysAvailable == 1) then
									if (ReadInteger(RushAvailableAddr) ~= 0x3F800000) then
										WriteInteger(RushAvailableAddr,0x3F800000)
									end
								end
												
								ourindex = ourindex + 1
								FirstPartyExp = FirstPartyExp + CharacterInfoOffset
								FirstPartyItemOneQty = FirstPartyItemOneQty + CharacterInfoOffset
							end
							
							ourindex = 0
										
							-- Next, Do Battle Options
							while (ourindex &lt; BattleInfoNumPartyMembers) do
								local InfiniteHP = ReadInteger(getAddressSafe("InfiniteHP"))
								local BaseCheckHP = OurBasePtr1 + 0x535E60
								
								if (InfiniteHP == 1) then
									if (ReadInteger(BaseCheckHP + (ourindex * 0x02)) ~= 0) then
										local MaxHP = ReadInteger(FirstPartyCurrentHP - 0x04)
										if (ReadInteger(FirstPartyCurrentHP) ~= MaxHP) then
											WriteInteger(FirstPartyCurrentHP,MaxHP)
										end
									end
								end

								local InfiniteRuneUseBattle = ReadInteger(getAddressSafe("InfiniteRuneUseBattle"))
								
								if (InfiniteRuneUseBattle == 1) then
									local MaxRuneUse = ReadInteger(FirstPartyCurrentHP + 0x04)
									if (ReadInteger(FirstPartyCurrentHP) ~= MaxRuneUse) then
										WriteInteger(FirstPartyCurrentHP + 0x08,MaxRuneUse)
									end
								end

								ourindex = ourindex + 1
								FirstPartyCurrentHP = FirstPartyCurrentHP + BattleInfoOffset
							end			
						end
					end
				end
			end
		end
	end
	
end

tMainTimer.Interval = 100
tMainTimer.Enabled = true

{$asm}

[DISABLE]
{$lua}

tMainTimer.destroy()

{$asm}
