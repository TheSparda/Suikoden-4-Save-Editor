	<CheatEntry>
	  <ID>320</ID>
	  <Description>"Infinite Item Use (Reset PCSX2 After Turning This On/Off)"</Description>
	  <VariableType>Auto Assembler Script</VariableType>
	  <AssemblerScript>[ENABLE]
{$lua}

WriteInteger(getAddressSafe("InfiniteItemUse"),1)

tInfItemTimer = createTimer(nil, false)
tInfItemTimer.OnTimer = function(fInfItemTimer)

	local InfiniteItemUse = ReadInteger(getAddressSafe("InfiniteItemUse"))
	local InfiniteItemUseAOB = getAddressSafe("InfiniteItemUseAOB")
	
	if (InfiniteItemUse == 1) then	
		if (InfiniteItemUseAOB ~= nil) then
			if (InfiniteItemUseAOB ~= 0) then
				if (ReadInteger(InfiniteItemUseAOB) ~= 0) then
					WriteInteger(InfiniteItemUseAOB,0)
				end
			end
		end
	else
		if (InfiniteItemUseAOB ~= nil) then
			if (InfiniteItemUseAOB ~= 0) then
				if (ReadInteger(InfiniteItemUseAOB) ~= 0x92220004) then
					WriteInteger(InfiniteItemUseAOB,0x92220004)
				else
					tInfItemTimer.destroy()
				end
			end
		end
	end
	
end

tInfItemTimer.Interval = 100
tInfItemTimer.Enabled = true

{$asm}

