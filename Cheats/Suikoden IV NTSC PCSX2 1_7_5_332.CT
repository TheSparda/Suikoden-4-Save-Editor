	<CheatEntry>
	  <ID>200</ID>
	  <Description>"Potch (Money) Multiplier / Infinite Potch (Money) (Enable After Loading Save/Starting New Game, Not At Title Menu)"</Description>
	  <Options moHideChildren="1"/>
	  <VariableType>Auto Assembler Script</VariableType>
	  <AssemblerScript>[ENABLE]
{$lua}

tGPMult = createTimer(nil, false)
tGPMult.OnTimer = function(fGPMult)

  local PotchOffset = getAddressSafe("PotchOffset")
  local GPMult = ReadQword(getAddress(getAddress("GPMultiplier")))
  local GPInitialized = ReadQword(getAddress("GPInitialized"))
  local GPSaved = getAddress("SavedGP")
  local InfGP = ReadQword(getAddress("InfiniteGP"))
  
  if (PotchOffset ~= nil) then
	if (PotchOffset ~= 0) then

	  if (GPInitialized == 0) then
		 WriteInteger(getAddress("GPInitialized"),1)
		 WriteInteger(GPSaved,ReadInteger(PotchOffset))
	  else
		local GPDifference = ReadInteger(PotchOffset) - ReadInteger(GPSaved)
		if (GPDifference &lt;= 0) then
		  if (InfGP == 1) then
			WriteInteger(PotchOffset,ReadInteger(GPSaved))
		  else
			WriteInteger(GPSaved,ReadInteger(PotchOffset))
		  end
		else
		  local GPMultiplied = GPDifference * GPMult
		  local NewGP = ReadInteger(GPSaved) + GPMultiplied
		  WriteInteger(PotchOffset,NewGP)
		  WriteInteger(GPSaved,NewGP)
		end
	  end		  

	end
  end

end
tGPMult.Interval = 250
tGPMult.Enabled = true

{$asm}

[DISABLE]
{$lua}

tGPMult.Destroy()
WriteInteger(getAddress("GPInitialized"),0)

{$asm}
</AssemblerScript>
