tNoRandomBattlesTimer = createTimer(nil, false)
tNoRandomBattlesTimer.OnTimer = function(fNoRandomBattlesTimer)

	local NoRandomBattles = ReadInteger(getAddressSafe("NoRandomBattles"))
	local NoRandomBattlesAOB = getAddressSafe("NoRandomBattlesAOB")
	
	if (NoRandomBattles == 1) then
		if (NoRandomBattlesAOB ~= nil) then
			if (NoRandomBattlesAOB ~= 0) then
				if (ReadInteger(NoRandomBattlesAOB) ~= 0x24020000) then
					WriteInteger(NoRandomBattlesAOB,0x24020000)
				end
			end
		end
	else
		if (NoRandomBattlesAOB ~= nil) then
			if (NoRandomBattlesAOB ~= 0) then
				if (ReadInteger(NoRandomBattlesAOB) ~= 0x0C0B575C) then
					WriteInteger(NoRandomBattlesAOB,0x0C0B575C)
				else
					tNoRandomBattlesTimer.destroy()
				end
			end
		end	
	end
end

tNoRandomBattlesTimer.Interval = 100
